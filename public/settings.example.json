{
  "version": 1,
  "logo": {
    "url": "https://assets.up4it.io/logos/up4it_logo.webp",
    "darkUrl": "https://assets.up4it.io/logos/up4it_logo-white.webp",
    "alt": "up4it"
  },
  "folders": {
    "libraryName": "team",
    "structures": [
      {
        "name": "src",
        "type": "folder",
        "children": [{ "id": "components", "name": "components", "type": "folder" }]
      },
      { "id": "guide", "name": "README.md", "type": "file" }
    ],
    "documentation": {
      "src": "# Source code\n\nKeep application code here.",
      "components": "# Team components\n\nKeep reusable UI components together.",
      "guide": "# Project guide\n\nDescribe setup and development commands."
    }
  },
  "issues": {
    "libraryName": "team-workflow",
    "structures": [
      {
        "name": "labels",
        "type": "folder",
        "children": [
          {
            "name": "priority",
            "type": "folder",
            "children": [
              {
                "id": "urgent",
                "name": "Urgent",
                "type": "file",
                "color": "#da3633",
                "description": "Work that blocks customers.",
                "example": "Checkout is unavailable."
              }
            ]
          }
        ]
      },
      {
        "name": "types",
        "type": "folder",
        "children": [
          {
            "name": "Development",
            "type": "folder",
            "children": [{ "id": "bug", "name": "Bug", "type": "file", "color": "#0969da" }]
          }
        ]
      },
      {
        "name": "Kanban",
        "type": "folder",
        "children": [
          { "id": "ready", "name": "Ready", "type": "file", "color": "#238636" },
          { "id": "done", "name": "Done", "type": "file", "color": "#8957e5" }
        ]
      }
    ],
    "documentation": {
      "urgent": "# Urgent\n\nAddress customer blockers first.",
      "bug": "# Bug\n\nDescribe expected and actual behavior.",
      "ready": "# Ready\n\nThe team has agreed on scope and acceptance criteria.",
      "done": "# Done\n\nThe change is reviewed, tested, and delivered."
    },
    "examples": [
      {
        "number": 1,
        "title": "fix: restore checkout",
        "open": true,
        "author": "team",
        "openedDaysAgo": 1,
        "comments": 2,
        "labels": ["urgent", "bug"],
        "status": "ready"
      }
    ]
  },
  "naming": {
    "title": "Team naming",
    "intro": "Use a type and a short description to explain each change.",
    "types": [
      {
        "prefix": "fix",
        "description": "Repair existing behavior.",
        "example": "fix: restore checkout",
        "tone": "#0969da"
      }
    ],
    "example": {
      "title": "fix: restore checkout",
      "description": "Explain the outcome in the title."
    },
    "rules": [
      { "title": "Describe the outcome", "description": "Use a short, imperative summary." }
    ]
  },
  "branches": {
    "libraryName": "Team branches",
    "description": "Small reviewed changes merge into main.",
    "branches": [
      {
        "id": "main",
        "label": "main",
        "kind": "trunk",
        "protected": true,
        "description": "Keep main ready to release."
      },
      {
        "id": "feature",
        "label": "feature/*",
        "kind": "feature",
        "description": "Use a short-lived branch for each change."
      }
    ],
    "edges": [{ "from": "feature", "to": "main" }]
  },
  "agentic": {
    "harness": {
      "name": "Team harness",
      "description": "Runs our project workflow.",
      "distinction": "The harness supplies the tools and permissions used by the agent.",
      "readme": "# Team harness\n\nRun the relevant project checks before handing work off."
    },
    "agents-md": {
      "readme": "# AGENTS.md\n\nPreserve unrelated changes and test the behavior you change."
    }
  }
}
